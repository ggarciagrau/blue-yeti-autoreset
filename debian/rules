#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/debian/blue-yeti-autoreset install
	# Debian ships the license as debian/copyright instead.
	rm -r $(CURDIR)/debian/blue-yeti-autoreset/usr/share/licenses

# Enable the boot and resume units, but never reset a connected microphone
# just because the package was installed or upgraded. The hotplug unit has no
# [Install] section; the udev rule starts it.
override_dh_installsystemd:
	dh_installsystemd --no-start blue-yeti-autoreset.service blue-yeti-autoreset-resume.service

# The OBS helper is opt-in per user (systemctl --user enable --now ...); never
# enable it globally, since it needs OBS and python3-websocket.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable
