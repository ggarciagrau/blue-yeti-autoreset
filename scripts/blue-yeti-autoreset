#!/bin/sh

set -eu

reset_tool=${BLUE_YETI_RESET_TOOL:-/usr/bin/blue-yeti-reset}
sysfs_root=${BLUE_YETI_SYSFS_ROOT:-/sys/bus/usb/devices}
# A reset makes the microphone re-enumerate, which fires the hotplug rule again.
# Skip any serial that was reset within this many seconds so the boot, resume
# and hotplug triggers never reset the same microphone twice in a row.
state_dir=${BLUE_YETI_STATE_DIR:-/run/blue-yeti-autoreset}
debounce_seconds=${BLUE_YETI_DEBOUNCE_SECONDS:-60}
settle_seconds=${BLUE_YETI_SETTLE_SECONDS:-0}
found=0
failed=0

recently_reset()
{
    stamp=$1
    [ -r "$stamp" ] || return 1
    last=
    IFS= read -r last < "$stamp" || return 1
    case $last in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ $(( $(date +%s) - last )) -lt "$debounce_seconds" ]
}

if [ "$settle_seconds" != 0 ]; then
    sleep "$settle_seconds"
fi

for device in "$sysfs_root"/*
do
    [ -d "$device" ] || continue
    [ -r "$device/idVendor" ] || continue
    [ -r "$device/idProduct" ] || continue
    [ -r "$device/bcdDevice" ] || continue
    [ -r "$device/serial" ] || continue

    id_vendor=
    id_product=
    bcd_device=
    serial=
    IFS= read -r id_vendor < "$device/idVendor" || continue
    IFS= read -r id_product < "$device/idProduct" || continue
    IFS= read -r bcd_device < "$device/bcdDevice" || continue
    IFS= read -r serial < "$device/serial" || continue

    if [ "$id_vendor" != 046d ] || [ "$id_product" != 0ab7 ] ||
        [ "$bcd_device" != 0020 ] || [ -z "$serial" ]; then
        continue
    fi

    found=1
    stamp="$state_dir/$(printf '%s' "$serial" | tr -c 'A-Za-z0-9._-' '_')"
    if recently_reset "$stamp"; then
        printf '%s\n' "Blue Yeti $serial was reset less than ${debounce_seconds}s ago; skipping."
        continue
    fi
    if mkdir -p "$state_dir" 2>/dev/null; then
        date +%s > "$stamp" || :
    fi

    if "$reset_tool" --execute-reset --serial "$serial"; then
        printf '%s\n' "Automatic Blue Yeti reset accepted for serial $serial."
    else
        failed=1
    fi
done

if [ "$found" -eq 0 ]; then
    printf '%s\n' "No supported Blue Yeti found; nothing to reset."
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi
